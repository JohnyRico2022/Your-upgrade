<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_bottom_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ru.nikita.yourupgrade.ui.common.BottomMenuItem
            android:id="@+id/tabHabits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            app:hintText="Задачи"
            app:icon="@drawable/ic_checklist_24" />

        <ru.nikita.yourupgrade.ui.common.BottomMenuItem
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            app:hintText="История"
            app:icon="@drawable/ic_calendar_24" />

        <ru.nikita.yourupgrade.ui.common.BottomMenuItem
            android:id="@+id/free"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            app:hintText="" />

        <ru.nikita.yourupgrade.ui.common.BottomMenuItem
            android:id="@+id/tabRewards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            app:hintText="Награды"
            app:icon="@drawable/ic_star_24" />

        <ru.nikita.yourupgrade.ui.common.BottomMenuItem
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            app:hintText="Настройки"
            app:icon="@drawable/ic_settings_24" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>