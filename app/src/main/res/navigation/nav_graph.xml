<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/habitsFragment">

    <fragment
        android:id="@+id/habitsFragment"
        android:name="ru.nikita.yourupgrade.ui.habits.HabitsFragment"
        android:label="Привычки" />

    <fragment
        android:id="@+id/habitDetailFragment"
        android:name="ru.nikita.yourupgrade.ui.habits_detail.HabitDetailFragment"
        android:label="Детали привычки">
        <argument
            android:name="habitId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="ru.nikita.yourupgrade.ui.stats.HistoryFragment"
        android:label="История" />

    <fragment
        android:id="@+id/userFragment"
        android:name="ru.nikita.yourupgrade.ui.user.UserFragment"
        android:label="Профиль" />

    <fragment
        android:id="@+id/rewardsFragment"
        android:name="ru.nikita.yourupgrade.ui.rewards.RewardsFragment"
        android:label="Награды" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="ru.nikita.yourupgrade.ui.settings.SettingsFragment"
        android:label="Настройки" />

</navigation>